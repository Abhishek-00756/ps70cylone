# Application environment: development | production
APP_ENV=development

# DEMO_MODE=true uses the local synthetic data pipeline (default, always works).
# DEMO_MODE=false requires a real SATELLITE_PROVIDER to be configured below;
# if it isn't, the API returns a clear 503 error rather than fake live data.
DEMO_MODE=true

# Which SatelliteDataProvider implementation to use: demo | imd | mosdac
SATELLITE_PROVIDER=demo

# Backend port
PORT=8000

# Only required if SATELLITE_PROVIDER=imd or =mosdac (NOT implemented in
# this prototype -- IMD/MOSDAC do not currently expose a public,
# credential-free imagery API suitable for this build; these are
# placeholders for a future real integration). Never commit real values.
IMD_API_KEY=
MOSDAC_API_KEY=
